# Copy to .env (next to where you run `noze`, or inside your NOZE_DATA_DIR) and fill what you need.
# Everything is optional — NOZE works with zero keys (18 sources need none).

# ── Where the bank lives ─────────────────────────────────────────────
# Point this at an external drive / NAS / synced folder if you like.
NOZE_DATA_DIR=./noze-data
NOZE_HOST=127.0.0.1
NOZE_PORT=8787
# Set a password if NOZE is reachable from other devices (HTTP Basic, any username).
NOZE_PASSWORD=
# Your email or site, added to the User-Agent (Wikimedia & museums appreciate it).
NOZE_CONTACT=

# ── Vibe search model ────────────────────────────────────────────────
# auto = CLIP if `pip install "noze[clip]"` is installed, otherwise lightweight hash+color vectors
# clip | siglip2 (multilingual, understands Indonesian queries natively; bigger) | hash
NOZE_EMBEDDER=auto

# ── Storage for full-size files (things you save/download) ───────────
# local = NOZE_DATA_DIR/blobs ; s3 = any S3-compatible bucket (pip install "noze[s3]")
NOZE_STORAGE=local
# Cloudflare R2:  https://<accountid>.r2.cloudflarestorage.com   (10 GB free, no egress fees)
# Backblaze B2:   https://s3.<region>.backblazeb2.com
# MinIO (self-hosted): http://your-nas:9000
NOZE_S3_ENDPOINT=
NOZE_S3_BUCKET=
NOZE_S3_ACCESS_KEY=
NOZE_S3_SECRET_KEY=
NOZE_S3_REGION=auto
NOZE_S3_PREFIX=noze/

# ── Behaviour ────────────────────────────────────────────────────────
NOZE_AUTO_DOWNLOAD_ON_SAVE=1      # saving to a board also downloads the original into the bank
NOZE_MAX_DOWNLOAD_MB=500
NOZE_VIDEO_MAX_WIDTH=1920         # pick ≤1080p stock video files to keep the bank small
NOZE_CACHE_TTL_HOURS=168          # re-ask a source about the same query after a week
NOZE_LIVE_TIMEOUT=12              # seconds to wait for sources during a search (slow ones finish in background)
NOZE_PER_SOURCE=30
NOZE_SAFE_SEARCH=1
NOZE_THUMB_SIZE=360
# NOZE_DISABLED_SOURCES=civitai,giphy
# NOZE_SOURCES=openverse,polyhaven     (only use these)
# NOZE_REDDIT_SUBS=motiondesign+AfterEffects+Cinema4D+blender

# ── Free API keys that unlock more sources ───────────────────────────
PEXELS_API_KEY=            # https://www.pexels.com/api/new/          photos + 4K stock video
PIXABAY_API_KEY=           # https://pixabay.com/api/docs/             photos, vectors, motion backgrounds
UNSPLASH_ACCESS_KEY=       # https://unsplash.com/oauth/applications   photos
TUMBLR_API_KEY=            # https://www.tumblr.com/oauth/apps  (the "OAuth consumer key")   aesthetic/moodboard posts
FLICKR_API_KEY=            # https://www.flickr.com/services/apps/create/apply/   photos (license per photo)
DEVIANTART_CLIENT_ID=      # https://www.deviantart.com/developers/apps   art community
DEVIANTART_CLIENT_SECRET=
VIMEO_ACCESS_TOKEN=        # https://developer.vimeo.com/apps → "Generate an unauthenticated access token"   motion reels
YOUTUBE_API_KEY=           # https://console.cloud.google.com/apis/library/youtube.googleapis.com
WALLHAVEN_API_KEY=         # optional — Wallhaven works without a key
FREESOUND_API_KEY=         # https://freesound.org/apiv2/apply/        sound effects
GIPHY_API_KEY=             # https://developers.giphy.com/dashboard/   GIFs & stickers (reference)
REDDIT_CLIENT_ID=          # https://www.reddit.com/prefs/apps  (type: script)
REDDIT_CLIENT_SECRET=
SMITHSONIAN_API_KEY=       # https://api.data.gov/signup/  (DEMO_KEY is used otherwise, very limited)
EUROPEANA_API_KEY=         # https://pro.europeana.eu/pages/get-api  (api2demo is used otherwise)
OPENVERSE_CLIENT_ID=       # https://api.openverse.org/v1/#tag/auth  (much higher rate limits)
OPENVERSE_CLIENT_SECRET=
GITHUB_TOKEN=              # https://github.com/settings/tokens  (no scopes needed; 30 searches/min)
ARENA_TOKEN=               # https://dev.are.na/oauth/applications  (optional)
WIKIMEDIA_TOKEN=           # https://api.wikimedia.org/wiki/Special:AppManagement  (optional, higher limits)

# Import YOUR OWN Pinterest boards via the official API (boards:read, pins:read)
PINTEREST_ACCESS_TOKEN=    # https://developers.pinterest.com/apps/

# Optional: generate what you can't find (paid per generation on Replicate)
REPLICATE_API_TOKEN=       # https://replicate.com/account/api-tokens
NOZE_GEN_VIDEO_MODEL=bytedance/seedance-1-lite
NOZE_GEN_IMAGE_MODEL=black-forest-labs/flux-schnell

# ══ Clipping studio (noze agency) ═══════════════════════════════════
# Full guide: docs/AGENCY.md. Everything below is optional.

# ── The team's brain (Claude) ───────────────────────────────────────
ANTHROPIC_API_KEY=          # https://console.anthropic.com  (or run `ant auth login`)
AGENCY_LLM=auto             # auto = Claude when credentials exist, else built-in heuristics | claude | off
AGENCY_MODEL=claude-opus-5-5
# AGENCY_MODEL_REVIEWER=claude-opus-5-5     # per role: MANAGER SCOUT ANALYST EDITOR REVIEWER REFLECTOR
# AGENCY_EFFORT_EDITOR=high                 # low | medium | high | xhigh | max
AGENCY_FALLBACKS=1          # server-side refusal fallbacks
AGENCY_JOB_BUDGET_USD=4     # LLM spend cap per source video (all its clips); heuristics take over above it
AGENCY_DAILY_BUDGET_USD=40

# ── Production ──────────────────────────────────────────────────────
AGENCY_AUTORUN=0            # 1 = `noze serve` also runs the studio in the background
AGENCY_PLATFORM=tiktok      # tiktok | reels | shorts — safe zones & length limits
AGENCY_CLIPS_PER_SOURCE=3
AGENCY_MIN_CLIP_S=15
AGENCY_MAX_CLIP_S=60
AGENCY_MAX_ROUNDS=3         # editor ↔ reviewer rounds before the manager decides
AGENCY_AUTO_APPROVE=1       # 0 = every clip waits for your approval (dashboard or `noze agency approve`)
AGENCY_TARGET_LUFS=-14
AGENCY_TRANSCRIBER=auto     # auto (sidecar .srt/.vtt, then faster-whisper) | faster-whisper | sidecar | none
AGENCY_WHISPER_MODEL=small  # tiny | base | small | medium | large-v3 | distil-large-v3
AGENCY_ALLOW_DOWNLOAD=0     # 1 = fetch platform links with yt-dlp (ONLY content the campaign lets you clip)
AGENCY_CANARY_SHARE=0.2     # share of jobs that try new (unproven) lessons
AGENCY_LEAD_SCOUT_EVERY_H=12  # while the studio runs: scout for new campaigns (0 = off)
AGENCY_REPORT_EVERY_H=24      # … and write the team report, sent to your webhook/Telegram if set (0 = off)

# ── Delivery & publishing ───────────────────────────────────────────
AGENCY_PUBLISH_TARGETS=folder        # + rclone, webhook, youtube, tiktok (comma separated)
AGENCY_AUTO_PUBLISH=0                # 1 = upload to youtube/tiktok without asking (they default to "ready")
AGENCY_RCLONE_REMOTE=                # e.g. gdrive:Clips  (https://rclone.org — Drive, Dropbox, OneDrive, R2…)
AGENCY_WEBHOOK_URL=                  # Discord / Slack / any JSON webhook — reports & "clip ready" messages
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
YOUTUBE_CLIENT_ID=                   # OAuth desktop client, scope youtube.upload (docs/AGENCY.md → YouTube)
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
AGENCY_YOUTUBE_PRIVACY=private       # private | unlisted | public
TIKTOK_ACCESS_TOKEN=                 # Content Posting API, scope video.upload → lands in your TikTok inbox as a draft

# ── Finding work (leads) ────────────────────────────────────────────
WHOP_API_KEY=                        # your Whop user token: open clipping bounties via the official Bounties API
# REDDIT_CLIENT_ID / REDDIT_CLIENT_SECRET above are reused (only already-approved apps; Reddit's API closes Mar 2027)
# YOUTUBE_API_KEY above is reused to search "clipping campaign" videos
AGENCY_LEAD_SUBREDDITS=VideoEditors_forhire,HireAnEditor,VideoEditor_forhire,VideoEditingRequests,CreatorServices,forhire
AGENCY_LEAD_FEEDS=                   # RSS/Atom feeds you trust (comma separated)
AGENCY_LEAD_KEYWORDS=clipper,clippers,clipping,short form editor,shorts editor,tiktok editor,reels editor
AGENCY_NICHES=                       # e.g. podcast,finance,gaming — helps the manager judge fit
AGENCY_LANGUAGES=en,id
