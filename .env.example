# ── Otak (Claude) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
JARVIS_MODEL=claude-opus-5
# low = cepat & hemat (cocok buat ngobrol), naikkan ke medium/high buat tugas berat
JARVIS_EFFORT=low
# Fallback otomatis kalau model menolak permintaan (set "off" untuk mematikan)
JARVIS_FALLBACKS=default

# ── Identitas ───────────────────────────────────────────────────
JARVIS_NAME=Jarvis
OWNER_NAME=NamaLu
# Cara Jarvis manggil lu
OWNER_HONORIFIC=Tuan

# ── HQ Dashboard ────────────────────────────────────────────────
PORT=3000
# 127.0.0.1 = cuma bisa diakses dari komputer lu. Pakai 0.0.0.0 kalau mau dari HP (WAJIB isi HQ_TOKEN).
HOST=127.0.0.1
HQ_TOKEN=

# ── Suara (TTS) ─────────────────────────────────────────────────
# elevenlabs | openai | chatterbox | browser
TTS_PROVIDER=browser

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

OPENAI_API_KEY=
OPENAI_TTS_VOICE=shimmer

CHATTERBOX_URL=http://127.0.0.1:8008

# ── WhatsApp ────────────────────────────────────────────────────
WHATSAPP_ENABLED=false
# Nomor lu (format internasional tanpa +), pisahkan koma kalau lebih dari satu.
# Jarvis CUMA bales nomor ini.
WHATSAPP_OWNER=628123456789
