	goldbun = { name = "Golden Mossbun", icon = "✨", weight = 0.7, rarity = "Legendary", minLevel = 3, creature = true, pay = 3, wants = { harvest = 4, grain = 2 }, desc = "A legend of the old roads. Brings luck and a shower of gold." },
