-- ─── daily Royal Orders: three new ones every dawn ─────────────────────────
export type Order = { id: string, text: string, stat: string, base: number, level: number? }
Catalog.Orders = {
	{ id = "sell_harvest", text = "Sell %d turnips", stat = "sold_harvest", base = 10 },
	{ id = "sell_catch", text = "Sell %d fish", stat = "sold_catch", base = 6, level = 2 },
	{ id = "sell_grain", text = "Sell %d bread", stat = "sold_grain", base = 6, level = 3 },
	{ id = "sell_stew", text = "Sell %d stew", stat = "sold_stew", base = 4, level = 5 },
	{ id = "kills", text = "Defeat %d Gloomlings", stat = "kills", base = 6 },
	{ id = "tips", text = "Collect %d tips", stat = "tips", base = 8 },
	{ id = "served", text = "Serve %d customers yourself", stat = "served", base = 5 },
	{ id = "happy", text = "Make %d visitors happy", stat = "happy", base = 6 },
	{ id = "tends", text = "Tend %d ripe fields", stat = "tends", base = 3 },
	{ id = "relights", text = "Relight %d snuffed lamps", stat = "relights", base = 2, level = 2 },
} :: { Order }
function Catalog.orderTarget(order: Order, level: number): number
	return math.floor(order.base * (1 + (level - 1) * 0.12) + 0.5)
end
function Catalog.orderReward(level: number): (number, number)
	return 25 + level * 10, 20 + level * 6 -- gold, xp
end

-- ─── achievements: three tiers of one stat each ────────────────────────────
export type Achievement = { id: string, name: string, icon: string, stat: string, tiers: { number }, desc: string }
Catalog.Achievements = {
	{ id = "merchant", name = "Merchant", icon = "🪙", stat = "sales", tiers = { 25, 250, 2500 }, desc = "Sell goods" },
	{ id = "warden", name = "Night Warden", icon = "⚔️", stat = "kills", tiers = { 10, 100, 500 }, desc = "Defeat Gloomlings" },
	{ id = "beloved", name = "Beloved", icon = "💛", stat = "happy", tiers = { 20, 200, 1000 }, desc = "Make visitors happy" },
	{ id = "tender", name = "Green Thumb", icon = "🌱", stat = "tends", tiers = { 10, 50, 200 }, desc = "Tend ripe fields" },
	{ id = "lamplighter", name = "Lamplighter", icon = "🏮", stat = "lights", tiers = { 5, 20, 50 }, desc = "Place lights" },
	{ id = "homemaker", name = "Homemaker", icon = "🏠", stat = "settlers", tiers = { 3, 8, 16 }, desc = "Welcome settlers" },
	{ id = "service", name = "Royal Service", icon = "🤝", stat = "served", tiers = { 10, 100, 500 }, desc = "Serve customers yourself" },
	{ id = "tipjar", name = "Tip Jar", icon = "💰", stat = "tips", tiers = { 25, 250, 1500 }, desc = "Collect tips" },
	{ id = "builder", name = "Master Builder", icon = "🔨", stat = "placed", tiers = { 20, 100, 300 }, desc = "Place buildings" },
	{ id = "flame", name = "Flamekeeper", icon = "🔥", stat = "tier", tiers = { 2, 3, 4 }, desc = "Raise the Heartflame" },
	{ id = "codex", name = "Collector", icon = "📖", stat = "discovered", tiers = { 4, 7, 9 }, desc = "Discover visitor kinds" },
	{ id = "nights", name = "Lantern Keeper", icon = "🌙", stat = "nights", tiers = { 3, 15, 50 }, desc = "Run Lantern Markets" },
	{ id = "surges", name = "Veilbreaker", icon = "🌀", stat = "surges", tiers = { 1, 10, 40 }, desc = "Repel Veil Surges" },
	{ id = "sovereign", name = "Sovereign", icon = "👑", stat = "level", tiers = { 6, 10, 20 }, desc = "Reach Village, Town, Kingdom" },
} :: { Achievement }
Catalog.AchievementLumen = { 5, 15, 40 }
Catalog.TierNames = { "Bronze", "Silver", "Gold" }

return Catalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Codec</string>
          <string name="Source"><![CDATA[--!strict
-- Packs a plot's moving things (visitors, settlers, Gloomlings) into a small buffer, 8 bytes each,
-- so ten snapshots a second fit easily under the UnreliableRemoteEvent payload limit.
-- Layout: u8 plot, u8 count, then per entity: u16 id, u8 kind, u16 x·256, u16 z·256, u8 info.

local Catalog = require(script.Parent.Catalog)

local Codec = {}

Codec.SETTLER_BASE = 20
Codec.GLOOM = 40
Codec.MAX = 100

-- visitor state codes (low 3 bits of info)
Codec.WALK = 0
Codec.IDLE = 1
Codec.LINGER = 2
Codec.FLEE = 3

local kindIndex: { [string]: number } = {}
for i, k in Catalog.VisitorOrder do
	kindIndex[k] = i
end
Codec.kindIndex = kindIndex

local function fixed(v: number): number
	return math.clamp(math.floor(v * 256 + 0.5), 0, 65535)
end

local function visitorInfo(v: any): number
	local st = v.state
	local code = Codec.WALK
	if st == "queue" or st == "buy" then
		code = Codec.IDLE
	elseif st == "linger" then
		code = Codec.LINGER
	elseif st == "flee" then
		code = Codec.FLEE
	end
	local info = code
	if v.mood == 1 then
		info += 8
	elseif v.mood == -1 then
		info += 16
	end
	if v.fear >= 18 then
		info += 32
	end
	info += (v.seed % 4) * 64
	return info
end

function Codec.encode(plot: number, sim: any): buffer
	local items = {}
	for _, v in sim.visitors do
		if v.state ~= "gone" then
			table.insert(items, { v.id, kindIndex[v.kind] or 1, v.x, v.z, visitorInfo(v) })
		end
	end
	local shown = 0
	for _, s in sim.settlers do
		if not s.inside and shown < 24 then
			shown += 1
			local moving = s.pi <= #s.path
			table.insert(items, { s.id, Codec.SETTLER_BASE + (kindIndex[s.kind] or 1), s.x, s.z, (moving and 0 or 1) + (s.seed % 32) * 8 })
		end
	end
	for _, g in sim.gloom do
		local hp = math.clamp(math.floor(g.hp / g.maxHp * 31 + 0.5), 0, 31)
		local info = hp + (g.snuff > 0 and 32 or 0) + (g.surge and 64 or 0) + (g.chasing and 128 or 0)
		table.insert(items, { g.id, Codec.GLOOM, g.x, g.z, info })
	end
	local n = math.min(#items, Codec.MAX)
	local b = buffer.create(2 + n * 8)
	buffer.writeu8(b, 0, plot)
	buffer.writeu8(b, 1, n)
	for i = 1, n do
		local it = items[i]
		local o = 2 + (i - 1) * 8
		buffer.writeu16(b, o, it[1])
		buffer.writeu8(b, o + 2, it[2])
		buffer.writeu16(b, o + 3, fixed(it[3]))
		buffer.writeu16(b, o + 5, fixed(it[4]))
		buffer.writeu8(b, o + 7, it[5])
	end
	return b
end

export type Entity = { id: number, kind: number, x: number, z: number, info: number }

function Codec.decode(b: buffer): (number, { Entity })
	local plot = buffer.readu8(b, 0)
	local n = buffer.readu8(b, 1)
	local out = table.create(n)
	for i = 1, n do
		local o = 2 + (i - 1) * 8
		out[i] = {
			id = buffer.readu16(b, o),
			kind = buffer.readu8(b, o + 2),
			x = buffer.readu16(b, o + 3) / 256,
			z = buffer.readu16(b, o + 5) / 256,
			info = buffer.readu8(b, o + 7),
		}
	end
	return plot, out
end

return Codec
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Tunables for Kingsbloom: Lantern Market (Roblox).
-- Every number here is a placeholder tuned for a fun first hour; change freely.

local Config = {}

-- World
Config.TILE = 6 -- studs per grid tile
Config.PLOT_W = 30
Config.PLOT_H = 30
Config.PLOT_COUNT = 6
Config.HEARTFLAME = { x = 15, z = 13 } -- tile-corner coordinates of the Heartflame's centre
Config.ENTRANCE = { x = 15, z = 29 } -- visitors walk in here (the plot's outer edge)

-- Day and night (seconds). Day market all day; the Lantern Market (bonus) and the Veil at night.
Config.DAY_LENGTH = 210
Config.DUSK_LENGTH = 20
Config.NIGHT_LENGTH = 170
Config.DAWN_LENGTH = 20

-- Economy
Config.START_GOLD = 120
Config.START_STOCK = { harvest = 12, grain = 0, catch = 0, stew = 0 }
Config.STORE_CAP_BASE = 60 -- per good; Granaries add more
Config.NIGHT_PRICE_MULT = 1.25
Config.COST_GROWTH = 1.12 -- each extra building of the same kind costs 12% more
Config.REFUND = 0.5

-- Visitors
Config.VISITOR_SPEED = 1.7 -- tiles per second
Config.MAX_VISITORS = 16
Config.FEAR_DARK_STEP = 6
Config.FEAR_TURN_BACK = 45
Config.LIT = 0.18

-- The Veil
Config.GLOOM_MAX = 5 -- at once, before the midnight surge; +1 every 5 levels
Config.GLOOM_HP = 36
Config.GLOOM_SPEED = 1.15
Config.GLOOM_TOUCH_DAMAGE = 6
Config.GLOOM_TOUCH_COOLDOWN = 1.6
Config.HEARTH_HEAL = 12 -- health per second while you stand in the Heartflame's glow
Config.LAMP_SNUFF_TIME = 14 -- seconds a Gloomling needs beside a lamp to snuff it

-- Combat (the Lantern Staff)
Config.STAFF_DAMAGE = 14
Config.STAFF_RANGE = 11 -- studs
Config.STAFF_ARC = 0.25 -- dot product threshold (wide arc)
Config.STAFF_COOLDOWN = 0.32
Config.COMBO_FINISHER_MULT = 1.8
Config.BURST_DAMAGE = 30
Config.BURST_RADIUS = 20
Config.BURST_COOLDOWN = 9

-- Collecting and serving
Config.TIP_PICKUP_RADIUS = 7
Config.SERVE_RADIUS = 8
Config.TEND_INTERVAL = 55 -- a field ripens this often (seconds of daylight)

-- Saving
Config.DATASTORE = "KingsbloomLanternMarket_v1"
Config.AUTOSAVE = 90

-- Sounds: official Roblox, APM and ProSoundEffects uploads from the Creator Store (public, free).
-- Swap any id for one you like; an empty string mutes that sound.
Config.SOUNDS = {
	click = "rbxassetid://15675059323", -- Roblox_UI_Bright_Click
	pop = "rbxassetid://15675055424", -- Roblox_UI_Cute_Pop
	whoosh = "rbxassetid://15674975792", -- Roblox_UI_Whoosh_03
	notify = "rbxassetid://17208361335", -- Roblox GUI - Notification High
	pickup = "rbxassetid://17208319162", -- Roblox GUI - Pickup
	coin = "rbxassetid://127645268874265", -- CoinTransfer_01 (Roblox)
	coins = "rbxassetid://9113849492", -- Coins Or Keys Jingle 6
	place = "rbxassetid://9120888980", -- Wood Hits Board Impacts On Fence Post 7
	hammer = "rbxassetid://9114756916", -- Hammer Nail Into Wood 25
	remove = "rbxassetid://9113225986", -- Axe Impact Giant Thuddy Hits On Wood Floor 5
	error = "rbxassetid://12221967", -- button.wav (Roblox), played low
	levelup = "rbxassetid://1845411858", -- Top Prize (APM)
	rankup = "rbxassetid://1836473422", -- Victory Fanfare Sting (APM)
	quest = "rbxassetid://125706237686412", -- Glistening Harp - Sting (APM)
	achievement = "rbxassetid://9126073001", -- Synth Sparkle Tone High Pitch Bell Tone Ding
	sparkle = "rbxassetid://9116395089", -- Magic Glows Soft Clusters Of Chiming Hits 4
	swing = "rbxassetid://9120972321", -- Wood Whoosh Slicing Air Quick Swings 4
	hit = "rbxassetid://9116394545", -- Magic Glows Soft Clusters Of Chiming Hits 1
	burst = "rbxassetid://9116384485", -- Magic Burst 1
	poof = "rbxassetid://9125640290", -- Magic Poofs Short Breathy Bursts
	gloom = "rbxassetid://9113970398", -- Creature Blip 8
	hurt = "rbxassetid://9113991080", -- Creature Vocal Spider Hiss Squawk 1
	bell = "rbxassetid://9125440445", -- Church Bell Single Successive Hits
	tend = "rbxassetid://9116394876", -- Magic Glows Soft Clusters Of Chiming Hits 2
	-- ambience loops
	ambDay = "rbxassetid://9113444532", -- Birds Peaceful 2
	ambNight = "rbxassetid://9112835862", -- Night Ambience 1
	ambWind = "rbxassetid://9116258071", -- Leaves Rustle Wind Blowing Through Trees 1
	ambCrowd = "rbxassetid://9112841064", -- Outdoor Walla 2
}

-- Music playlists (APM, public). Crossfaded by time of day.
Config.MUSIC_DAY = {
	"rbxassetid://131370222076689", -- Market Place
